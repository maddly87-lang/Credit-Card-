OCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SecurePay AI - {{ request.endpoint|capitalize }}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { background-color: #0f172a; color: #f8fafc; }
        .glass-card { background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.1); }
        .nav-link.active { background-color: #1e293b; color: #38bdf8; border-left: 4px solid #38bdf8; }
        .nav-link:hover { background-color: #1e293b; color: #38bdf8; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
    </style>
</head>
<body class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col hidden md:flex">
        <div class="h-16 flex items-center px-6 border-b border-slate-800">
            <i class="fa-solid fa-shield-halved text-cyan-400 text-2xl mr-3"></i>
            <span class="text-xl font-bold tracking-wider text-white">SecurePay AI</span>
        </div>
        <div class="flex-1 overflow-y-auto py-4">
            <nav class="space-y-1">
                <a href="{{ url_for('dashboard') }}" class="nav-link flex items-center px-6 py-3 {% if request.endpoint == 'dashboard' %}active{% endif %}">
                    <i class="fa-solid fa-chart-pie w-6"></i> Dashboard
                </a>
                <a href="{{ url_for('transactions') }}" class="nav-link flex items-center px-6 py-3 {% if request.endpoint == 'transactions' %}active{% endif %}">
                    <i class="fa-solid fa-list w-6"></i> Transactions
                </a>
